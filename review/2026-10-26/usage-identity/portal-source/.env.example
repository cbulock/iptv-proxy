# Local development; use https://media.bulock.house in production.
APP_URL=http://localhost:3000
# Generate independent values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
DATABASE_PATH=data/portal.sqlite
# Immutable Plex account ID of the administrator. Not an email or username.
ADMIN_PLEX_ID=
PLEX_SERVER_ID=
PLEX_OWNER_TOKEN=
PLEX_URL=https://plex.bulock.house
JELLYFIN_URL=https://jellyfin.bulock.house
JELLYFIN_INTERNAL_URL=https://jellyfin.bulock.house
JELLYFIN_API_KEY=
SEERR_URL=https://plexhelp.bulock.house
IPTV_URL=https://iptv.bulock.house
IPTV_MEDIA_URL=https://iptv.bulock.house/media
# Private gateway origin for monitoring; Compose sets this on the portal.
IPTV_GATEWAY_INTERNAL_URL=http://iptv-gateway:3400
# Same independent secret in portal and gateway; never expose the internal API publicly.
IPTV_INTERNAL_KEY=
# Optional: same independent value on this gateway and IPTV Proxy for Usage viewer names.
IPTV_USAGE_IDENTITY_SECRET=
IPTV_PUBLIC_URL=https://iptv.bulock.house
# Reachable PRIVATE endpoints from the gateway container; original ports must not remain public.
IPTV_UPSTREAM_URL=http://iptv-proxy:34400
# Optional: leave empty for a protected setup/download landing page.
IPTV_VIEWER_URL=
PORTAL_INTERNAL_URL=http://portal:3000
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=media@bulock.com
SMTP_FROM=Bulock Media <media@bulock.com>
# Dedicated Proton SMTP token, never your mailbox password.
SMTP_PASSWORD=
# Each secret setting also accepts NAME_FILE=/run/secrets/name.

# Separate viewer checkout, relative to the Compose project directory.
IPTV_VIEWER_BUILD_CONTEXT=../iptv-web
